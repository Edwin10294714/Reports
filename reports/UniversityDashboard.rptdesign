                </list-property>
            </structure>
            <property name="dataSource">UniversityPostgreSQL</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">year_name</property>
                    <property name="nativeName">year_name</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">semester_name</property>
                    <property name="nativeName">semester_name</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">enrolment_status</property>
                    <property name="nativeName">enrolment_status</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">student_count</property>
                    <property name="nativeName">student_count</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">-5</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
    ay.year_name,
    se.semester_name,
    e.enrolment_status,
    COUNT(*) AS student_count
FROM university.enrolments e
JOIN university.academic_years ay
    ON ay.academic_year_id = e.academic_year_id
JOIN university.semesters se
    ON se.semester_id = e.semester_id
WHERE ay.year_name = ?
GROUP BY
    ay.year_name,
    se.semester_name,
    se.start_date,
    e.enrolment_status
ORDER BY
    se.start_date,
    e.enrolment_status;]]></xml-property>
        </oda-data-set>
