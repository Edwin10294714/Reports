            <xml-property name="queryText"><![CDATA[SELECT
    d.department_code,
    d.department_name,
    COUNT(st.staff_id) AS staff_count
FROM university.staff st
JOIN university.departments d
    ON d.department_id = st.department_id
GROUP BY
    d.department_id,
    d.department_code,
    d.department_name
ORDER BY
    staff_count DESC,
    d.department_code;]]></xml-property>
