            <xml-property name="queryText"><![CDATA[SELECT
    st.student_status,
    COUNT(*) AS student_count
FROM university.students st
GROUP BY
    st.student_status
ORDER BY
    CASE st.student_status
        WHEN 'Active' THEN 1
        WHEN 'Deferred' THEN 2
        WHEN 'Graduated' THEN 3
        ELSE 4
    END;]]></xml-property>
