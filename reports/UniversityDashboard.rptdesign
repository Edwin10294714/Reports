                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
    p.programme_code,
    p.programme_name,
    COUNT(DISTINCT e.student_id) AS student_count
FROM university.enrolments e
JOIN university.students st
    ON st.student_id = e.student_id
JOIN university.programmes p
    ON p.programme_id = st.programme_id
JOIN university.academic_years ay
    ON ay.academic_year_id = e.academic_year_id
WHERE ay.year_name = ?
  AND e.enrolment_status IN ('Enrolled', 'Completed')
GROUP BY
    p.programme_id,
    p.programme_code,
    p.programme_name
ORDER BY
    student_count DESC,
    p.programme_code;]]></xml-property>
