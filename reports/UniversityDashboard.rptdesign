            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">programme_code</property>
                    <property name="nativeName">programme_code</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">programme_name</property>
                    <property name="nativeName">programme_name</property>
